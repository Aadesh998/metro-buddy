# Railway sets PORT, DATABASE_URL (Postgres plugin) and REDIS_URL (Redis plugin).
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://metro:metro@localhost:55432/metro_buddy?sslmode=disable
REDIS_URL=redis://localhost:56379/0
PUBLIC_BASE_URL=http://localhost:8080

# Secrets: >=32 random chars each (openssl rand -base64 48). DATA_KEY is exactly 32 bytes, base64.
JWT_SECRET=
PHONE_PEPPER=
IP_PEPPER=
DATA_KEY=

# SMS: dev | msg91. OTP_DEV_CODE only works when APP_ENV=development.
SMS_PROVIDER=dev
OTP_DEV_CODE=123456
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SOS_FLOW_ID=
# Optional fallback when MSG91 fails
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
NSFW_ENDPOINT=

ANTHROPIC_API_KEY=
EXPO_ACCESS_TOKEN=

# Self-hosted S3-compatible storage (RustFS/MinIO/Garage) instead of R2. Must be reachable by phones.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=metro-buddy
# Self-hosted image scanner (services/nsfw). POST image bytes -> {"nsfw": 0..1}
NSFW_TOKEN=
# SMS_PROVIDER=gateway sends through SMS Gateway for Android (open source) from a phone's own SIM.
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1/messages
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=

# Selfie liveness (F07): "rekognition" uses AWS Face Liveness; empty uses a pass-through fake outside production.
LIVENESS_PROVIDER=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Device integrity (F06). Failures only tighten rate limits.
PLAY_INTEGRITY_PACKAGE=in.metrobuddy.app
PLAY_INTEGRITY_CREDENTIALS_JSON=
APPLE_APP_ID=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

ADMIN_BOOTSTRAP_EMAIL=
