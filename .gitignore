.env
.env.*
!.env.example
.DS_Store
.~lock.*#
apps/mobile/play-service-account.json

# Local-only files: builds, keys, credentials, toolchains, logs (see scripts/android-env.sh)
.local/
*.apk
*.aab
*.keystore
*.jks
*.p12
*.pem
# Apple's public App Attest root certificate, embedded in the server binary
!server/internal/attest/apple_app_attestation_root.pem
# Firebase config holds an API key; each developer/CI provides its own copy
google-services.json
GoogleService-Info.plist
*firebase-adminsdk*.json
service-account*.json

# Instagram reel workspace: assets, renders and a copy of the ElevenLabs/Gemini keys
instagram-reel/
